# Form submissions (quote and contact forms) are sent to this Telegram chat.
# 1. Create a bot with @BotFather and copy its token.
# 2. Add the bot to the chat/group that should receive requests (or message it directly),
#    then open https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public address of the site (e.g. https://example.uz), used for absolute links in social previews.
NEXT_PUBLIC_SITE_URL=
